{
  "languages": {
    "Python": {
      "language_servers": ["pyright", "ruff", "!basepyright", "!pylsp"],
      "format_on_save": "on",
    },
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "analysis": {
            "typeCheckingMode": "basic",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true,
          },
        },
      },
    },
  },
}
